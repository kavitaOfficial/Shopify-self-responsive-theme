{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{% comment %} <style>
.promo-bar {
  width: 100%;
  background: rgb(var(--color-background));
  color: rgb(var(--color-foreground));
  font-size: var(--font-size-body);
}
.promo-bar__item {
  padding: 0.8rem 1.2rem;
  text-align: center;
  transition: opacity 0.3s ease;
}
.promo-bar__text,
.promo-bar__link {
  font-size: inherit;
  color: inherit;
  line-height: 1.4;
}
.promo-bar__link {
  text-decoration: underline;
  text-underline-offset: 0.2em;
}
@media screen and (min-width: 750px) {
  .promo-bar__item {
    padding: 1rem 2rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  .promo-bar {
    transition: none;
  }
}
</style> {% endcomment %}
<slideshow-component  class="announcement-bar" role="region" aria-roledescription="{{ 'sections.announcements.carousel' | t }}"  aria-label="{{ 'sections.announcements.announcement_bar' | t }}">
    <div class="announcement-bar-slider slider-buttons">
    <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{'sections.announcements.previous_announcement' | t }}" aria-controls="Slider-{{ section.id }}" >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
          <div class="grid grid--1-col slider slider--everywhere" id="Slider-{{ section.id }}" aria-live="polite" aria-atomic="true" data-autoplay="{{ section.settings.auto_rotate }}" data-speed="{{ section.settings.change_slides_speed }}">
            {%- for block in section.blocks -%}
              <div
                class="slideshow__slide slider__slide grid__item grid--1-col"
                id="Slide-{{ section.id }}-{{ forloop.index }}"
                {{ block.shopify_attributes }}
                role="group"
                aria-roledescription="Carousel"
                aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                tabindex="-1"
              >
                <div
                  class="announcement-bar__promo"
                  role="region"
                  aria-label="{{ 'sections.header.announcement' | t }}"
                >
                  {%- if block.settings.text != blank -%}
                    {%- if block.settings.link != blank -%}
                      <a
                        href="{{ block.settings.link }}"
                        class="announcement-bar__link link link--text focus-inset animate-arrow"
                      >
                    {%- endif -%}
                    <p class="announcement-bar__message h5">
                      <span>{{ block.settings.text | escape }}</span>
                      {%- if block.settings.link != blank -%}
                        {{- 'icon-arrow.svg' | inline_asset_content -}}
                      {%- endif -%}
                    </p>
                    {%- if block.settings.link != blank -%}
                      </a>
                    {%- endif -%}
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'sections.announcements.next_announcement' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>
</slideshow-component>

 {%- if request.design_mode -%}
        <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
        <style>
          /* theme editor power preview fix */
          .announcement-bar-slider .slider__slide[aria-hidden='true'] {
            visibility: hidden;
          }
        </style>
      {%- endif -%}
 {% comment %} <script src="{{ 'promo-bar.js' | asset_url }}" defer="defer"></script> {% endcomment %}
{% schema %}
{
  "name": "promo-bar",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_on_page",
      "label": "Show on page",
      "default": true
    }
  ],
   "blocks": [
    {
      "type": "text",
      "name": "Promo Text",
      "settings": [
        {
          "type": "text",
          "id": "promo_text",
          "label": "Promo Text"
        },
        {
          "type": "url",
          "id": "promo_link",
          "label": "Promo Link"
        }
      ]
    }
   ],
   "presets": [
    {
      "name": "Promo Bar",
      "category": "Announcement"
    }
   ]
}
{% endschema %}