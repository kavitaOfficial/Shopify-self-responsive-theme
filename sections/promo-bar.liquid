{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{% comment %} <style>
.promo-bar {
  width: 100%;
  background: rgb(var(--color-background));
  color: rgb(var(--color-foreground));
  font-size: var(--font-size-body);
}
.promo-bar__item {
  padding: 0.8rem 1.2rem;
  text-align: center;
  transition: opacity 0.3s ease;
}
.promo-bar__text,
.promo-bar__link {
  font-size: inherit;
  color: inherit;
  line-height: 1.4;
}
.promo-bar__link {
  text-decoration: underline;
  text-underline-offset: 0.2em;
}
@media screen and (min-width: 750px) {
  .promo-bar__item {
    padding: 1rem 2rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  .promo-bar {
    transition: none;
  }
}
</style> {% endcomment %}
<slideshow-component class="announcement-bar" role="region">
  <div class="announcement-bar-slider slider-buttons">
    <button class="slider-button slider-button--prev" name="previous">
      <span class="svg-wrapper">
        {{ 'icon-caret.svg' | inline_asset_content }}
      </span>
    </button>

    <div
      class="grid grid--1-col slider slider--everywhere"
      id="Slider-{{ section.id }}"
      data-autoplay="{{ section.settings.auto_rotate }}"
      data-speed="{{ section.settings.change_slides_speed }}"
    >
      {% for block in section.blocks %}
        <div
          class="slideshow__slide slider__slide grid__item grid--1-col"
          {% if forloop.first %}
            aria-hidden="false"
          {% else %}
            aria-hidden="true"
            tabindex="-1"
          {% endif %}
        >
          <div class="announcement-bar__announcement">
            <p class="announcement-bar__message h5">
              <span>{{ block.settings.promo_text }}</span>
            </p>
          </div>
        </div>
      {% endfor %}
    </div>

    <button class="slider-button slider-button--next" name="next">
      <span class="svg-wrapper">
        {{ 'icon-caret.svg' | inline_asset_content }}
      </span>
    </button>
  </div>
</slideshow-component>



 {%- if request.design_mode -%}
        <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
        <style>
          /* theme editor power preview fix */
          .announcement-bar-slider .slider__slide[aria-hidden='true'] {
            visibility: hidden;
          }
        </style>
      {%- endif -%}
 {% comment %} <script src="{{ 'promo-bar.js' | asset_url }}" defer="defer"></script> {% endcomment %}
{% schema %}
{
  "name": "promo-bar",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_on_page",
      "label": "Show on page",
      "default": true
    },
    {
  "type": "checkbox",
  "id": "auto_rotate",
  "label": "Auto rotate",
  "default": false
},
{
  "type": "range",
  "id": "change_slides_speed",
  "min": 3,
  "max": 10,
  "step": 1,
  "unit": "s",
  "label": "Change slides speed",
  "default": 5
}

  ],
   "blocks": [
    {
      "type": "text",
      "name": "Promo Text",
      "settings": [
        {
          "type": "text",
          "id": "promo_text",
          "label": "Promo Text"
        },
        {
          "type": "url",
          "id": "promo_link",
          "label": "Promo Link"
        }
      ]
    }
   ],
   "presets": [
    {
      "name": "Promo Bar",
      "category": "Announcement"
    }
   ]
}
{% endschema %}