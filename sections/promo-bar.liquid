{% comment %}
  Announcement Bar Slider - Production Ready
  Features:
  ✅ Conditional rendering
  ✅ Autoplay
  ✅ Dots navigation
  ✅ Prev / Next buttons
  ✅ Shopify section + blocks
{% endcomment %}

<style>
  .announcement-bar-wrapper {
  width: 100%;
  overflow: hidden;
  background: #f8f8f8;
  display: flex;
  justify-content: center;
}

.slider {
  display: flex;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  scrollbar-width: none;
}

.slider::-webkit-scrollbar {
  display: none;
}

.slider__slide {
  min-width: 100%;
  flex-shrink: 0;
  scroll-snap-align: center;
  padding: 1rem;
  box-sizing: border-box;
}

.slider-button {
  cursor: pointer;
  background: transparent;
  border: none;
  font-size: 1.2rem;
}

.slider-dots {
  display: flex;
  justify-content: center;
  margin-top: 0.5rem;
}

.slider-dots .dot {
  width: 0.8rem;
  height: 0.8rem;
  border-radius: 50%;
  background: rgba(0,0,0,0.2);
  margin: 0 0.3rem;
  cursor: pointer;
}

.slider-dots .dot.active {
  background: #000;
}

</style>

<div class="announcement-bar-wrapper">
  {% if section.blocks.size > 0 %}
    <slideshow-component class="announcement-bar" role="region">
      <div class="announcement-bar-slider slider-buttons">
        <button type="button" class="slider-button slider-button--prev" aria-label="Previous" disabled>
          &lt;
        </button>

        <div class="slider" id="Slider-{{ section.id }}" 
             data-autoplay="{{ section.settings.auto_rotate }}"
             data-speed="{{ section.settings.change_slides_speed }}">
          {% for block in section.blocks %}
            {% if block.settings.text != blank %}
              <div class="slideshow__slide slider__slide" tabindex="-1">
                {% if block.settings.link != blank %}
                  <a href="{{ block.settings.link }}" class="announcement-bar__link">
                {% endif %}
                  <p class="announcement-bar__message">{{ block.settings.text | escape }}</p>
                {% if block.settings.link != blank %}
                  </a>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <button type="button" class="slider-button slider-button--next" aria-label="Next">
          &gt;
        </button>
      </div>

      <div class="slider-dots"></div>
    </slideshow-component>
  {% endif %}
</div>
<script>
  document.addEventListener('DOMContentLoaded', () => {
  const sliders = document.querySelectorAll('slideshow-component.announcement-bar');

  sliders.forEach(sliderComponent => {
    const slider = sliderComponent.querySelector('.slider');
    const slides = Array.from(slider.children);
    if (!slides.length) return; // ❌ No slides, exit
    const prev = sliderComponent.querySelector('.slider-button--prev');
    const next = sliderComponent.querySelector('.slider-button--next');
    const dotsContainer = sliderComponent.querySelector('.slider-dots');

    let index = 0;
    const speed = parseInt(slider.dataset.speed || 5, 10) * 1000;
    const autoplay = slider.dataset.autoplay === 'true';
    let autoplayInterval;

    // Build dots
    slides.forEach((_, i) => {
      const dot = document.createElement('div');
      dot.classList.add('dot');
      if (i === 0) dot.classList.add('active');
      dot.addEventListener('click', () => goToSlide(i));
      dotsContainer.appendChild(dot);
    });

    const dots = Array.from(dotsContainer.children);

    function updateUI() {
      slides.forEach((slide, i) => slide.setAttribute('aria-hidden', i !== index));
      dots.forEach((dot, i) => dot.classList.toggle('active', i === index));
      prev.disabled = index === 0;
      next.disabled = index === slides.length - 1;
    }

    function goToSlide(i) {
      index = i;
      slider.scrollTo({ left: slides[index].offsetLeft, behavior: 'smooth' });
      updateUI();
    }

    prev.addEventListener('click', () => goToSlide(Math.max(index - 1, 0)));
    next.addEventListener('click', () => goToSlide(Math.min(index + 1, slides.length - 1)));

    if (autoplay) {
      function startAutoplay() {
        autoplayInterval = setInterval(() => {
          index = (index + 1) % slides.length;
          goToSlide(index);
        }, speed);
      }
      function stopAutoplay() { clearInterval(autoplayInterval); }
      sliderComponent.addEventListener('mouseenter', stopAutoplay);
      sliderComponent.addEventListener('mouseleave', startAutoplay);
      startAutoplay();
    }

    updateUI();
  });
});

</script>
{% schema %}
{
  "name": "Announcement Slider",
  "max_blocks": 10,
  "settings": [
    { "type": "checkbox", "id": "auto_rotate", "label": "Autoplay", "default": true },
    { "type": "range", "id": "change_slides_speed", "label": "Autoplay Speed (s)", "min": 3, "max": 10, "default": 5 }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Slide",
      "settings": [
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Announcement Slider", "category": "Header" }]
}
{% endschema %}
