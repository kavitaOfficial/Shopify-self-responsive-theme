{% comment %}
  Announcement Bar Slider - Production Ready
  Features:
  ✅ Conditional rendering
  ✅ Autoplay
  ✅ Dots navigation
  ✅ Prev / Next buttons
  ✅ Shopify section + blocks
{% endcomment %}

<style>
  .announcement-bar-wrapper {
  width: 100%;
  overflow: hidden;
  background: #f8f8f8;
  display: flex;
  justify-content: center;
}

.slider {
  display: flex;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  scrollbar-width: none;
}

.slider::-webkit-scrollbar {
  display: none;
}

.slider__slide {
  min-width: 100%;
  flex-shrink: 0;
  scroll-snap-align: center;
  padding: 1rem;
  box-sizing: border-box;
}

.slider-button {
  cursor: pointer;
  background: transparent;
  border: none;
  font-size: 1.2rem;
}

.slider-dots {
  display: flex;
  justify-content: center;
  margin-top: 0.5rem;
}

.slider-dots .dot {
  width: 0.8rem;
  height: 0.8rem;
  border-radius: 50%;
  background: rgba(0,0,0,0.2);
  margin: 0 0.3rem;
  cursor: pointer;
}

.slider-dots .dot.active {
  background: #000;
}

</style>

<div class="announcement-bar-wrapper">
  {% if section.blocks.size > 0 %}
    <slideshow-component class="announcement-bar" role="region">
      <div class="announcement-bar-slider slider-buttons">
        <button type="button" class="slider-button slider-button--prev" aria-label="Previous" disabled>
          &lt;
        </button>

        <div class="slider" id="Slider-{{ section.id }}" 
             data-autoplay="{{ section.settings.auto_rotate }}"
             data-speed="{{ section.settings.change_slides_speed }}">
          {% for block in section.blocks %}
            {% if block.settings.text != blank %}
              <div class="slideshow__slide slider__slide" tabindex="-1">
                {% if block.settings.link != blank %}
                  <a href="{{ block.settings.link }}" class="announcement-bar__link">
                {% endif %}
                  <p class="announcement-bar__message">{{ block.settings.text | escape }}</p>
                {% if block.settings.link != blank %}
                  </a>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <button type="button" class="slider-button slider-button--next" aria-label="Next">
          &gt;
        </button>
      </div>

      <div class="slider-dots"></div>
    </slideshow-component>
  {% endif %}
</div>
