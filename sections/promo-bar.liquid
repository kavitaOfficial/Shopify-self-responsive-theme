<style>
.promo-bar {
  width: 100%;
  background: rgb(var(--color-background));
  color: rgb(var(--color-foreground));
  font-size: var(--font-size-body);
}

.promo-bar__item {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0.8rem 1.2rem;
  text-align: center;
  transition: opacity 0.3s ease;
}
.promo-bar__text,
.promo-bar__link {
  font-size: inherit;
  color: inherit;
  line-height: 1.4;
}
.promo-bar__link {
  text-decoration: underline;
  text-underline-offset: 0.2em;
}
@media screen and (min-width: 750px) {
  .promo-bar__item {
    padding: 1rem 2rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  .promo-bar {
    transition: none;
  }
}


</style>


{% if section.settings.show_on_page and section.blocks.size > 0 %}
  <div
    class="promo-bar"
    {% if section.blocks.size > 1 %}
      data-rotate="true"
      data-interval="3000"
    {% endif %}
    role="region"
    aria-label="Promotional messages"
  >
    {% for block in section.blocks %}
      <div
        class="promo-bar__item"
        {% if forloop.index != 1 %}
          hidden
        {% endif %}
        {{ block.shopify_attributes }}
      >
        {% if block.settings.promo_link != blank %}
          <a
            href="{{ block.settings.promo_link }}"
            class="promo-bar__link"
          >
            {{ block.settings.promo_text }}
          </a>
        {% else %}
          <span class="promo-bar__text">
            {{ block.settings.promo_text }}
          </span>
        {% endif %}
      </div>
    {% endfor %}
  </div>
{% endif %}
 <script src="{{ 'promo-bar.js' | asset_url }}" defer="defer"></script>
{% schema %}
{
  "name": "promo-bar",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_on_page",
      "label": "Show on page",
      "default": true
    }
  ],
   "blocks": [
    {
      "type": "text",
      "name": "Promo Text",
      "settings": [
        {
          "type": "text",
          "id": "promo_text",
          "label": "Promo Text"
        },
        {
          "type": "url",
          "id": "promo_link",
          "label": "Promo Link"
        }
      ]
    }
   ],
   "presets": [
    {
      "name": "Promo Bar",
      "category": "Announcement"
    }
   ]
}
{% endschema %}