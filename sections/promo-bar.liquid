{% if section.settings.show_on_page and section.blocks.size > 0 %}
  <div
    class="promo-bar"
    {% if section.blocks.size > 1 %}
      data-rotate="true"
      data-interval="3000"
    {% endif %}
    role="region"
    aria-label="Promotional messages"
  >
    {% for block in section.blocks %}
      <div
        class="promo-bar__item"
        {% if forloop.index != 1 %}
          hidden
        {% endif %}
        {{ block.shopify_attributes }}
      >
        {% if block.settings.promo_link != blank %}
          <a
            href="{{ block.settings.promo_link }}"
            class="promo-bar__link"
          >
            {{ block.settings.promo_text }}
          </a>
        {% else %}
          <span class="promo-bar__text">
            {{ block.settings.promo_text }}
          </span>
        {% endif %}
      </div>
    {% endfor %}
  </div>
{% endif %}
 <script src="{{ 'promo-bar.js' | asset_url }}" defer="defer"></script>
{% schema %}
{
  "name": "promo-bar",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_on_page",
      "label": "Show on page",
      "default": true
    }
  ],
   "blocks": [
    {
      "type": "text",
      "name": "Promo Text",
      "settings": [
        {
          "type": "text",
          "id": "promo_text",
          "label": "Promo Text"
        },
        {
          "type": "url",
          "id": "promo_link",
          "label": "Promo Link"
        }
      ]
    }
   ],
   "presets": [
    {
      "name": "Promo Bar",
      "category": "Announcement"
    }
   ]
}
{% endschema %}