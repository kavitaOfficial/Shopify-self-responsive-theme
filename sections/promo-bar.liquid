<style>
  .u-announcement {
  position: relative;
  overflow: hidden;
  background: rgb(var(--color-background));
  color: rgb(var(--color-foreground));
}

.u-slider-track {
  display: flex;
  transition: transform 0.4s ease;
  will-change: transform;
}

.u-slide {
  min-width: 100%;
  text-align: center;
  padding: 1rem;
}

.u-slider-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: none;
  border: none;
  font-size: 2rem;
  cursor: pointer;
}

.u-slider-btn.prev { left: 0.5rem; }
.u-slider-btn.next { right: 0.5rem; }

</style>

<div
  class="u-announcement"
  data-slider
  data-autoplay="{{ section.settings.autoplay }}"
  data-interval="{{ section.settings.interval | times: 1000 }}"
>

  <button class="u-slider-btn prev" type="button" aria-label="Previous">
    ‹
  </button>

  <div class="u-slider-track">
    {% for block in section.blocks %}
      <div
        class="u-slide"
        data-slide
        data-block-id="{{ block.id }}"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}">
        {% endif %}

          <p>{{ block.settings.text }}</p>

        {% if block.settings.link != blank %}
          </a>
        {% endif %}
      </div>
    {% endfor %}
  </div>

  <button class="u-slider-btn next" type="button" aria-label="Next">
    ›
  </button>

</div>

{% schema %}
{
  "name": "U_Announcement Slider",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "interval",
      "label": "Autoplay interval",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Universal Announcement Slider",
      "blocks": [{ "type": "announcement" }]
    }
  ]
}
{% endschema %}
