<section id="custom-banner-{{ section.id }}" class="custom-banner">

  <!-- Image(s) placeholder -->
  <div class="custom-banner__media">
    {% if section.settings.banner_image %}
        {{ section.settings.banner_image | image_url: width: 2200 | image_tag: 
            widths: '360, 540, 720, 940, 1100, 1500, 2200',
            sizes: '100vw',
            alt: section.settings.banner_image.alt | escape 
        }}
    {% endif %}
  </div>

  <!-- Text/content placeholder -->
  <div class="custom-banner__content">
    {% for block in section.blocks %}
        {% case block.type %}
            {% when 'heading' %}
                 {% if block.settings.heading != blank %}
                    <h2 class="custom-banner__heading">{{ block.settings.heading }}</h2>
                 {% endif %}
            {% when 'text' %}
                {% if block.settings.heading != blank %}
                    <p class="custom-banner__text">{{ block.settings.text }}</p>
                {% endif %}
            {% when 'button' %}
                {% if block.settings.label != blank %}
                    <a href="{{ block.settings.button_link }}" class="custom-banner__button">
                        {{ block.settings.label }}
                    </a>
                {% endif %}
        {% endcase %}
    {% endfor %}
  </div>

</section>

{% schema %}
{
  "name": "Custom Image Banner",
  "settings": [
    {
        "type": "image_picker",
        "id": "banner_image",
        "label": "Banner Image"
    }
  ],
  "blocks": [
   {
        "type": "heading",
        "name": "Heading",
        "settings": [
            {
            "type": "text",
            "id": "heading",
            "label": "Heading text"
            }
        ]
    },
   {
        "type": "Text",
        "name": "Text",
        "settings": [
            {
            "type": "textarea",
            "id": "text",
            "label": "Text"
            }
        ]
    },
    {
        "type": "button",
        "name": "Button",
        "settings": [
            {
            "type": "text",
            "id": "label",
            "label": "Button Label"
            },
            {
            "type": "url",
            "id": "button_link",
            "label": "Button Link"
            }   
        ]
    }   
  ],
  "presets": [{"name": "Custom Image Banner"}]
}
{% endschema %}