{% comment %}
  Product Family Metaobject
{% endcomment %}
{{ 'custom-accordion.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-accordion.js' | asset_url }}" defer="defer"></script>
{% assign materials_list = product.metafields.custom.materials_sustainability.value %}

{% if family or materials_list != blank %}
            <div class="product-details custom-page-width">
              <div class="product__accordion accordion  custom-accordion quick-add-hidden" {{ block.shopify_attributes }}>
                  {% if family %}
                  <details id="Details-product-extra_details" open>
                    <summary>
                      <div class="summary__title">
                        <h2 class="accordion__title custom-heading">Why We Made This</h2>
                       {% comment %} {{- 'icon-caret.svg' | inline_asset_content -}} {% endcomment %}
                       <span class="custom-toggles">
                        {{- 'icon-plus.svg' | inline_asset_content -}}
                        {{- 'icon-minus.svg' | inline_asset_content -}}
                       </span>
                       </div>
                    </summary>

                      <div class="accordion__content product-info" id="product-extra_details">
                        <div class="product-info__left">
                          {% comment %} Description {% endcomment %}
                          {% if family.description %}
                            <div class="product-description">
                              {{ family.description | metafield_tag }}
                            </div>
                          {% endif %}
                    
                          {% comment %} Best For {% endcomment %}
                              {% if family.product_info_best_for.value != blank %}
                                <div class="product-best-for">
                                  <h3 class="custom-accordion-subheading">Best For</h3>
                                  <div class="product-best-for-container">
                                    {% for item in family.product_info_best_for.value %}
                                      <span class="product-best-for-items">{{ item }}</span>
                                    {% endfor %}
                                  </div>

                                  {% comment %} Technical Details {% endcomment %}
                                  {% if family.product_technical_details %}
                                  <h4 class="technical_detail_toggle"> {{- 'icon-caret.svg' | inline_asset_content -}}
                                     <span class="toggle_text">
                                       <span class="toggle_view">View</span> Technical Details</span>
                                    </h4>
                                    <div class="product-technical-details">
                                      {{ family.product_technical_details | metafield_tag }}
                                    </div>
                                  {% endif %}    

                                </div>
                              {% endif %}
                              
                        </div>
                        {% comment %} Media {% endcomment %}
                        {% assign media = family.product_info_media.value %}
                         {% if media %}
                        <div class="product-info__center">
                            <div class="feature-circle">
                                <div class="feature-circle__outer">
                                    <div class="feature-circle__inner">
                                      <div class="feature-circle__product-media">
                                        {{
                                        media
                                        | image_url: width: 500
                                        | image_tag: loading: 'lazy'
                                      }}
                                      </div>
                                    </div>
                                </div>
                                
                            </div>
                        </div>
                        {% endif %} 
                        <div class="product-info__right">
                              {% if family.product_info_thoughtfully_designed %}
                              <h3 class="custom-accordion-subheading">Thoughtfully Designed</h3>
                                {{ family.product_info_thoughtfully_designed | metafield_tag }}
                              {% endif %}
                        </div>
                    </div>
                  </details>
                  {% endif %}

                  {% comment %} =========================  Accordion Item 2 Materials ========================== {% endcomment %}
                  {% if materials_list != blank %}
                  <details id="Details-materials_sustainability">
                    <summary>
                      <div class="summary__title">
                        <h2 class="accordion__title custom-heading">Materials & Sustainability </h2>
                       {% comment %} {{- 'icon-caret.svg' | inline_asset_content -}} {% endcomment %}
                       <span class="custom-toggles">
                        {{- 'icon-plus.svg' | inline_asset_content -}}
                        {{- 'icon-minus.svg' | inline_asset_content -}}
                       </span>
                       </div>
                    </summary>
                    <div class="accordion__content product-info grid--3-col grid--1-col" id="materials_sustainability">
                        {% for material in materials_list %}
                            <div class="material flex">
                              {% assign image = material.media.value %}
                              {% if image %}
                               <div class="material_left"> {{
                                  image
                                  | image_url: width: 100
                                  | image_tag: loading: 'lazy'
                                }}</div>
                              {% endif %}
                              <div class="material_right">
                                {% if material.label != blank %}
                                {% comment %} <h3 class="material_heading">{{- material.label | metafield_tag -}}</h3> {% endcomment %}
                                 <h3 class="material_heading">
                                    {% assign richtext = material.label.value %}

                                    {% for block in richtext.children %}
                                      {% for node in block.children %}
                                        {% if node.bold %}
                                          <strong>{{ node.value }}</strong>
                                        {% elsif node.italic %}
                                          <em>{{ node.value }}</em>
                                        {% else %}
                                          {{ node.value }}
                                        {% endif %}
                                      {% endfor %}
                                    {% endfor %}
                                  </h3>
                                {% endif %}
                              
                                {% if material.content != blank %}
                                  <p class="material_content">{{- material.content -}}</p>
                                {% endif %}
                              </div>
                              
                            </div>

                          {% endfor %}
                       </div>
                  </details>
                  {% endif %}

                  {% comment %} =========================  Accordion Item 3 Care ========================== {% endcomment %}
                    {% if family.product_care_information != blank %}
                  <details id="Details-care_information">
                    <summary>
                      <div class="summary__title">
                        <h2 class="accordion__title custom-heading">Care instructions</h2>
                       {% comment %} {{- 'icon-caret.svg' | inline_asset_content -}} {% endcomment %}
                       <span class="custom-toggles">
                        {{- 'icon-plus.svg' | inline_asset_content -}}
                        {{- 'icon-minus.svg' | inline_asset_content -}}
                       </span>
                       </div>
                    </summary>
                    <div class="accordion__content product-info" id="ProductAccordion-care_information">
                        {% for item in family.product_care_information.value %}
                           <span class="care-items">{{ item }}</span>
                        {% endfor %}
                    </div>
                  </details>
                   {% endif %}
                </div>
          </div>
{% endif %}


  {% assign background_image = material_hero_feature.background_image.value %}
  {% assign features_image = material_hero_feature.features_image.value %}
  {% assign features =material_hero_feature.features_items.value %}
  <div class="feature-circle">
      <div class="feature-circle__outer">
          <div class="feature-circle__inner">
                  <div class="feature-circle__product-media">{{ features_image | image_url: width: 900 | image_tag }}</div>
              </div>
        </div>
    </div>