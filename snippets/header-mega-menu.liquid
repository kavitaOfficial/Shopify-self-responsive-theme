{% comment %}
  Mega menu with highlight support for all menu levels.
{% endcomment %}

{{ 'mega-menu-practice.css' | asset_url | stylesheet_tag }}

<nav class="header__inline-menu">

  <ul class="list-menu list-menu--inline" role="list">

    {% comment %} Highlight menu titles from Theme Editor {% endcomment %}
    {% assign highlight_items = section.settings.highlight_menu_items | strip | downcase %}
    {% assign highlight_items_with_commas = ',' | append: highlight_items | append: ',' %}

    {% for link in section.settings.menu.links %}

      {% comment %} Check top-level menu {% endcomment %}
      {% assign normalized_link_title = link.title | strip | downcase %}
      {% assign current_title = ',' | append: normalized_link_title | append: ',' %}
      {% assign is_highlighted = false %}

      {% if highlight_items_with_commas contains current_title %}
        {% assign is_highlighted = true %}
      {% endif %}

      <li>

        {% if link.links != blank %}

          <header-menu>

            <details
              id="Details-HeaderMenu-{{ forloop.index }}"
              class="mega-menu"
            >

              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset{% if is_highlighted %} header__menu-item--highlight{% endif %}"
              >

                <span
                  {% if link.child_active %}
                    class="header__active-menu-item"
                  {% endif %}
                >
                  {{ link.title | escape }}
                </span>

                {{ 'icon-caret.svg' | inline_asset_content }}

              </summary>

              <div
                id="MegaMenu-Content-{{ forloop.index }}"
                class="mega-menu__content color-{{ section.settings.menu_color_scheme }} gradient motion-reduce global-settings-popup"
                tabindex="-1"
              >

                <div class="mega-menu__inner page-width">

                  {% comment %} Menu links {% endcomment %}
                  <ul
                    class="mega-menu__list{% if link.levels == 1 %} mega-menu__list--condensed{% endif %}"
                    role="list"
                  >

                    {% for childlink in link.links %}

                      {% comment %} Check child menu {% endcomment %}
                      {% assign normalized_childlink_title = childlink.title | strip | downcase %}
                      {% assign child_title = ',' | append: normalized_childlink_title | append: ',' %}
                      {% assign is_child_highlighted = false %}

                      {% if highlight_items_with_commas contains child_title %}
                        {% assign is_child_highlighted = true %}
                      {% endif %}

                      <li>

                        <a
                          id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                          href="{{ childlink.url }}"
                          class="mega-menu__link mega-menu__link--level-2 link{% if childlink.current %} mega-menu__link--active{% endif %}{% if is_child_highlighted %} mega-menu__link--highlight{% endif %}"
                          {% if childlink.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          {{ childlink.title | escape }}
                        </a>

                        {% if childlink.links != blank %}

                          <ul class="list-unstyled" role="list">

                            {% for grandchildlink in childlink.links %}

                              {% comment %} Check grandchild menu {% endcomment %}
                              {% assign normalized_grandchild_title = grandchildlink.title | strip | downcase %}
                              {% assign grandchild_title = ',' | append: normalized_grandchild_title | append: ',' %}
                              {% assign is_grandchild_highlighted = false %}

                              {% if highlight_items_with_commas contains grandchild_title %}
                                {% assign is_grandchild_highlighted = true %}
                              {% endif %}

                              <li>

                                <a
                                  id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                  href="{{ grandchildlink.url }}"
                                  class="mega-menu__link link{% if grandchildlink.current %} mega-menu__link--active{% endif %}{% if is_grandchild_highlighted %} mega-menu__link--highlight{% endif %}"
                                  {% if grandchildlink.current %}
                                    aria-current="page"
                                  {% endif %}
                                >
                                  {{ grandchildlink.title | escape }}
                                </a>

                              </li>

                            {% endfor %}

                          </ul>

                        {% endif %}

                      </li>

                    {% endfor %}

                  </ul>

                  {% comment %} Promotional images {% endcomment %}
                  <div class="mega-menu__promotional-images">

                    {% for block in section.blocks %}

                      {% if block.type == 'mega_menu_item' %}

                        {% assign normalized_block_title = block.settings.menu_title | strip | downcase %}

                        {% if normalized_link_title == normalized_block_title %}

                          {% if block.settings.image != blank %}

                            <div
                              class="mega-menu__media"
                              {{ block.shopify_attributes }}
                            >

                              {% if block.settings.link != blank %}
                                <a
                                  href="{{ block.settings.link }}"
                                  class="mega-menu__image-link"
                                >
                              {% endif %}

                                <div class="mega-menu__image">

                                  {{
                                    block.settings.image
                                    | image_url: width: 900
                                    | image_tag:
                                      loading: 'lazy',
                                      widths: '400, 600, 750, 900',
                                      sizes: '(min-width: 990px) 20vw, 50vw',
                                      alt: block.settings.image.alt | default: block.settings.image_title
                                  }}

                                </div>

                                {% if block.settings.image_title != blank %}

                                  <div class="mega-menu__media-content">

                                    <span class="mega-menu__media-title">
                                      {{ block.settings.image_title | escape }}
                                    </span>

                                  </div>

                                {% endif %}

                              {% if block.settings.link != blank %}
                                </a>
                              {% endif %}

                            </div>

                          {% endif %}

                        {% endif %}

                      {% endif %}

                    {% endfor %}

                  </div>

                </div>

              </div>

            </details>

          </header-menu>

        {% else %}

          {% comment %} Top-level item without children {% endcomment %}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{{ link.url }}"
            class="header__menu-item list-menu__item link link--text focus-inset{% if is_highlighted %} header__menu-item--highlight{% endif %}"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >

            <span
              {% if link.current %}
                class="header__active-menu-item"
              {% endif %}
            >
              {{ link.title | escape }}
            </span>

          </a>

        {% endif %}

      </li>

    {% endfor %}

  </ul>

</nav>